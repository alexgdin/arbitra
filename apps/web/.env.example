# Copiază acest fișier ca apps/web/.env.
# Schema e în apps/web/.env.schema.

# Folosește aceeași valoare ca în apps/server/.env; implicit false.
# true = ecran de mentenanță pentru vizitatori și utilizatori obișnuiți.
MAINTENANCE_MODE=false

# URL-ul serverului (Hono) apelat de browser
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
