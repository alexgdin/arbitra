# Copiază acest fișier ca apps/server/.env și completează valorile.
# Schema (tipuri, obligatoriu/opțional) e în apps/server/.env.schema.

# Cel puțin 32 de caractere. Generează unul cu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=schimba-ma-cu-un-secret-aleator-de-minim-32-de-caractere

# URL-ul public al serverului (Hono) și al aplicației web
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# PostgreSQL (de exemplu Neon: copiază connection string-ul din consolă)
DATABASE_URL=postgresql://user:parola@localhost:5432/pretpilot
